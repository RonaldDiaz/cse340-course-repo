<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Available Service Projects</h2>

        <div class="projects-grid">
            <% projects.forEach(project=> { %>
                <div class="project-card">
                    <div class="project-card-header">
                        <h3>
                            <a href="/project/<%= project.project_id %>" class="project-link">
                                <%= project.title %>
                            </a>
                        </h3>
                        <a href="/organization/<%= project.organization_id %>" class="org-badge">
                            <%= project.organization_name %>
                        </a>
                    </div>

                    <div class="project-card-body">
                        <p><strong>Location:</strong>
                            <%= project.location %>
                        </p>
                        <p><strong>Date:</strong>
                            <%= project.project_date.toLocaleDateString('en-US', { weekday: 'short' , year: 'numeric' ,
                                month: 'short' , day: 'numeric' }) %>
                        </p>
                    </div>
                </div>
                <% }); %>
        </div>
    </main>
    <%- include('partials/footer') %>


