<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Update the details below to modify this community service project.</p>

        <form action="/edit-project/<%= project.project_id %>" method="POST" class="app-form">
            <div class="form-group">
                <label for="organizationId">Sponsoring Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="" disabled>-- Select an Organization --</option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>" <%=org.organization_id===project.organization_id
                            ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4" required><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" required />
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <% const formattedDate = project.project_date 
                    ? new Date(project.project_date).toISOString().split('T')[0] 
                    : '';
                %>
                <input type="date" id="date" name="date" value="<%= formattedDate %>" required />
            </div>

            <div class="form-actions">
                <a href="/project/<%= project.project_id %>" class="btn-secondary">&larr; Cancel</a>
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>