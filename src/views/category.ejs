<%- include('partials/header') %>
    <main>
        <% if (category) { %>
            <div class="section-header">
                <h1>
                    <%= category.name %>
                </h1>
                <a href="/edit-category/<%= category.category_id %>" class="btn-primary">
                    &#9998; Edit Category
                </a>
            </div>
            <p>Service projects currently available under this category:</p>

            <% if (projects && projects.length> 0) { %>
                <div class="projects-grid">
                    <% projects.forEach(project=> { %>
                        <%- include('partials/project-card', { project }) %>
                            <% }); %>
                </div>
                <% } else { %>
                    <p>No service projects are currently assigned to this category.</p>
                    <% } %>

                        <div class="category-actions">
                            <a href="/categories" class="btn-secondary">&larr; Back to All Categories</a>
                        </div>
                        <% } else { %>
                            <h1>Category Not Found</h1>
                            <p>Sorry, the service category you are looking for does not exist.</p>
                            <a href="/categories" class="btn-secondary">&larr; Back to All Categories</a>
                            <% } %>
    </main>
    <%- include('partials/footer') %>