<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Select the service categories that best describe this project:</p>

        <form action="/assign-categories/<%= projectId %>" method="POST" class="app-form">
            <div class="form-project-header">
                <span class="form-project-label">Project</span>
                <h2>
                    <%= projectDetails.title %>
                </h2>
            </div>

            <div class="form-group">
                <label>Available Categories</label>

                <% const assignedIds=(typeof assignedCategories
                    !=='undefined' && assignedCategories) ? assignedCategories.map(c=> c.category_id)
                    : [];
                    %>

                    <div class="checkbox-grid">
                        <% categories.forEach(category=> { %>
                            <!-- <div>
                                <input type="checkbox" id="category-<%= category.category_id %>" name="categoryIds"
                                    value="<%= category.category_id %>" <%=assignedCategories.some(ac=> ac.category_id === category.category_id) ?
                                'checked' : '' %>
                                />
                                <label for="category-<%= category.category_id %>">
                                    <%= category.name %>
                                </label>
                            </div> -->
                            <label class="checkbox-card" for="category-<%= category.category_id %>">
                                <input 
                                type="checkbox" 
                                id="category-<%= category.category_id %>" 
                                name="categoryIds"
                                value="<%= category.category_id %>" 
                                <%= assignedCategories.some(ac=> ac.category_id === category.category_id) ? 'checked' : '' %>
                                />
                                <span class="checkbox-label-text">
                                    <%= category.name %>
                                </span>
                            </label>
                            <% }); %>
                    </div>
            </div>

            <div class="form-actions">
                <a href="/project/<%= projectId %>" class="btn-secondary">&larr; Back to Project</a>
                <button type="submit" class="btn-primary">Save Categories</button>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>