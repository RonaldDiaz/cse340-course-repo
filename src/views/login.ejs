<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Sign in with your email and password to manage projects or volunteer.</p>

        <form action="/login" method="POST" class="app-form">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="jane.doe@example.com" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required />
            </div>

            <div class="form-actions">
                <a href="/register" class="btn-secondary">Don't have an account? Register</a>
                <button type="submit" class="btn-primary">Log In</button>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>