<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Complete the form below to publish a new community service project.</p>

        <form action="/new-project" method="POST" class="app-form">
            <div class="form-group">
                <label for="organizationId">Sponsoring Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="" disabled selected>-- Select an Organization --</option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>">
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" maxlength="150" placeholder="e.g., Community Garden Cleanup" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4" maxlength="500"
                    placeholder="Describe the project goals, activities, and volunteer tasks..." required></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" maxlength="255" placeholder="e.g., Central Community Park" required />
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" required />
            </div>

            <div class="form-actions">
                <a href="/projects" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">Create Project</button>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>