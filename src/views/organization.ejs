<%- include('partials/header') %>
    <main>
        <% if (organization) { %>
            <div class="org-profile-header">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"
                    class="org-profile-logo">

                <div class="org-profile-info">
                    <h1>
                        <%= organization.name %>
                    </h1>
                    <p class="org-contact">
                        <strong>Contact Email:</strong>
                        <a href="mailto:<%= organization.contact_email %>">
                            <%= organization.contact_email %>
                        </a>
                    </p>
                    <p class="org-description">
                        <%= organization.description %>
                    </p>
                </div>
            </div>

            <h2>Sponsored Service Projects</h2>
            <% if (projects && projects.length> 0) { %>
                <div class="projects-grid">
                    <% projects.forEach(project=> { %>
                        <%- include('partials/project-card', { project }) %>
                            <% }); %>
                </div>
                <% } else { %>
                    <p>This organization does not have any upcoming service projects at the moment.</p>
                    <% } %>

                        <div class="form-actions">
                            <a href="/organizations" class="btn-secondary">Back to All Organizations</a>
                            <% if (user && user.role_name==='admin' ) { %>
                                <a href="/edit-organization/<%= organization.organization_id %>" class="btn-primary">Edit Organization</a>
                            <% } %>
                        </div>
                        <% } else { %>
                            <h1>Organization Not Found</h1>
                            <p>Sorry, the partner organization you are looking for does not exist.</p>
                            <a href="/organizations" class="btn-secondary">Back to All Organizations</a>
                            <% } %>
    </main>
    <%- include('partials/footer') %>